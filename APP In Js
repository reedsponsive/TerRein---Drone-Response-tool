const $=id=>document.getElementById(id),cv=$("cv"),g=cv.getContext("2d");
const PACKS=[
{id:"landslide",title:"Landslide and slope movement",kw:["landslide","slope","hillside","erosion","crack","subsidence","moving","slip","mudslide","rockfall","unstable","collapse"],
sensor:"RTK-enabled RGB camera (add LiDAR if the slope is under dense tree cover)",alt:80,front:.8,side:.7,
timing:"Fly before and after heavy rain. Low morning or evening sun makes cracks easier to see.",revisit:"Every rainy season, plus after any major storm",
analysis:["Build an elevation model for each flight","Subtract the earlier model from the later one to measure ground movement","Flag cracks, steep new edges and changed drainage","Rank flagged zones by size, slope and nearby homes or roads"],
next:["Have a geotechnical engineer or the local geological survey review the flagged zones","Visit the top-ranked zones on foot and photograph them","Tell people living below flagged slopes what was found and what will be checked next","Repeat the survey after the next heavy rain to see whether anything changed"],
limits:["Sees the surface only, so it cannot detect movement deep underground","Measuring change needs an earlier survey; the first flight is only a baseline","Dense tree cover hides the ground unless LiDAR is used"],
expert:"a geotechnical engineer or the local geological survey",
demo:[["Ground movement","The surface changed by about {m} m between flights"],["Crack or new edge","A line of ground breakage about {w} m long"]]},
{id:"crop_pests",title:"Crop stress and pest spread",kw:["pest","crop","farm","field","infest","disease","blight","locust","armyworm","aphid","wilt","yellow","leaves","plants dying","harvest"],
sensor:"Multispectral camera (red-edge and near-infrared bands)",alt:60,front:.75,side:.7,
timing:"Fly early in the morning, at the same time of day on every visit.",revisit:"Weekly during the growing season",
analysis:["Build a vegetation-health map for each flight","Compare each patch against healthy crop in the same field","Flag patches whose health is dropping or spreading between visits","Produce a short scouting list ordered by patch size"],
next:["Walk the top patches and check leaves and stems for the actual cause","Ask a local agronomist or extension officer to confirm the cause before treating","Mark the patches on a field map and re-fly in a week to see if they grew"],
limits:["Pests, drought, poor soil and disease can look the same from above","It cannot name a pest species, only show where plants are stressed","Very early infestations may show nothing yet"],
expert:"a local agronomist or agricultural extension officer",
demo:[["Stressed patch","Plant health is lower than the rest of the field over about {a} m²"],["Spreading edge","A stressed patch that is wider than at the last visit"]]},
{id:"malaria_water",title:"Standing water and mosquito breeding sites",kw:["malaria","mosquito","standing water","puddle","breeding","larvae","dengue","stagnant","swamp","ditch","paddy","pond"],
sensor:"RGB camera, with a near-infrared band if available",alt:80,front:.8,side:.7,
timing:"Fly in the early morning, at the start, middle and end of the rainy season.",revisit:"Three times per rainy season, plus after heavy rain",
analysis:["Stitch images into a map","Detect water bodies and low-lying spots where water collects","Score each site by size, how long it lasts and distance to homes","Produce a ranked list of suspected breeding sites"],
next:["Send field workers to confirm the top sites and check for larvae","Treat or drain confirmed sites with the local malaria programme","Log what was found so the detector can be corrected"],
limits:["Shadows, wet soil and vegetation can be mistaken for water","A site must be checked on the ground before it is called a breeding site","Works only if a health programme can act on the results"],
expert:"the local malaria or vector-control programme",
demo:[["Standing water","A water body of about {a} m² close to homes"],["Low-lying pooling spot","Ground that is likely to hold water after rain"]]}];
PACKS.forEach(p=>{const o=document.createElement("option");o.value=p.id;o.textContent=p.title;$("pack").appendChild(o)});
let pts=[],path=null,last=null;
const W=()=>Math.min(5000,Math.max(100,+$("wid").value||1000)),LAT=()=>+$("lat").value,LON=()=>+$("lon").value;
const toPx=p=>[320+p[0]/W()*640,320-p[1]/W()*640];
const ll=p=>[LAT()+p[1]/110540,LON()+p[0]/(111320*Math.cos(LAT()*Math.PI/180))];
const area=poly=>Math.abs(poly.reduce((s,a,i)=>{const b=poly[(i+1)%poly.length];return s+a[0]*b[1]-b[0]*a[1]},0))/2;
function draw(){const cs=getComputedStyle(document.documentElement),v=n=>cs.getPropertyValue(n);
g.clearRect(0,0,640,640);g.strokeStyle=v("--line");g.lineWidth=1;
for(let i=1;i<10;i++){g.beginPath();g.moveTo(i*64,0);g.lineTo(i*64,640);g.moveTo(0,i*64);g.lineTo(640,i*64);g.stroke()}
if(pts.length){g.beginPath();pts.forEach((p,i)=>{const q=toPx(p);i?g.lineTo(q[0],q[1]):g.moveTo(q[0],q[1])});
if(pts.length>2){g.closePath();g.fillStyle=v("--accent");g.globalAlpha=.18;g.fill();g.globalAlpha=1}
g.strokeStyle=v("--accent");g.lineWidth=2.5;g.stroke();pts.forEach(p=>{const q=toPx(p);g.fillStyle=v("--ink");g.fillRect(q[0]-4,q[1]-4,8,8)})}
if(path){g.beginPath();path.forEach((w,i)=>{const q=toPx(w);i?g.lineTo(q[0],q[1]):g.moveTo(q[0],q[1])});g.strokeStyle=v("--path");g.lineWidth=1.5;g.stroke()}
const sq=`Each grid square is ${Math.round(W()/10)} m.`;
$("hint").textContent=pts.length?`${pts.length} points, about ${(area(pts)/1e4).toFixed(1)} ha. ${sq}`:`Click on the map to mark the area you are worried about. ${sq}`}
cv.addEventListener("click",e=>{const r=cv.getBoundingClientRect(),x=(e.clientX-r.left)/r.width*640,y=(e.clientY-r.top)/r.height*640;pts.push([(x-320)/640*W(),-(y-320)/640*W()]);path=null;draw()});
$("undo").onclick=()=>{pts.pop();path=null;draw()};
$("clear").onclick=()=>{pts=[];path=null;$("out").hidden=true;draw()};
["lat","lon","wid"].forEach(i=>$(i).addEventListener("input",()=>{path=null;draw()}));
$("ex").onclick=()=>{pts=[[-280,230],[300,240],[330,-180],[-120,-250],[-300,-60]];path=null;$("worry").value="I think the slope above our village is moving after the rains";draw()};
function matchWorry(t){t=t.toLowerCase();const s=PACKS.map(p=>[p.kw.filter(k=>t.includes(k)).length,p]).sort((a,b)=>b[0]-a[0]);
if(!s[0][0])return["none",s];return[s[0][0]>=2&&s[0][0]-s[1][0]>=1?"confident":"confirm",s]}
const CAM={sw:17.3,f:12.3,wp:5280,hp:3956};
function inside(p,poly){let c=false;for(let i=0;i<poly.length;i++){const a=poly[i],b=poly[(i+1)%poly.length];if((a[1]>p[1])!==(b[1]>p[1])&&p[0]<(b[0]-a[0])*(p[1]-a[1])/(b[1]-a[1])+a[0])c=!c}return c}
function planMission(pk,poly,altIn){const alt=altIn||pk.alt,gsd=CAM.sw*alt*100/(CAM.f*CAM.wp),fw=gsd/100*CAM.wp,fh=gsd/100*CAM.hp,sp=fw*(1-pk.side),pg=fh*(1-pk.front);
const xs=poly.map(p=>p[0]),ys=poly.map(p=>p[1]),ax=Math.max(...xs)-Math.min(...xs)>=Math.max(...ys)-Math.min(...ys);
const[a0,a1,c0,c1]=ax?[Math.min(...xs),Math.max(...xs),Math.min(...ys),Math.max(...ys)]:[Math.min(...ys),Math.max(...ys),Math.min(...xs),Math.max(...xs)];
const segs=[];let flip=false;
for(let c=c0+sp/2;c<=c1+sp/2;c+=sp){const runs=[];let run=null;
for(let t=a0;t<=a1;t+=2){if(inside(ax?[t,c]:[c,t],poly))run=run?[run[0],t]:[t,t];else if(run){runs.push(run);run=null}}
if(run)runs.push(run);const mk=t=>ax?[t,c]:[c,t];
(flip?runs.slice().reverse():runs).forEach(r=>{let s=r[0]-fh/2,e=r[1]+fh/2;if(flip)[s,e]=[e,s];segs.push([mk(s),mk(e)])});
if(runs.length)flip=!flip}
if(!segs.length)throw new Error("The area is too small for this altitude. Draw a bigger area or lower the altitude.");
let dist=0,photos=0,wp=[];segs.forEach((sg,i)=>{const L=Math.hypot(sg[1][0]-sg[0][0],sg[1][1]-sg[0][1]);dist+=L;photos+=Math.ceil(L/pg)+1;
if(i)dist+=Math.hypot(sg[0][0]-segs[i-1][1][0],sg[0][1]-segs[i-1][1][1]);wp.push(sg[0],sg[1])});
const speed=Math.min(8,pg/2),secs=dist/speed;
return{alt,gsd:+gsd.toFixed(2),lines:segs.length,photos,km:+(dist/1000).toFixed(2),min:Math.round(secs/60),batt:Math.max(1,Math.ceil(secs/(35*60*.8))),ha:+(area(poly)/1e4).toFixed(2),wp}}
function rng(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function demoFindings(pk,poly){const r=rng(3),xs=poly.map(p=>p[0]),ys=poly.map(p=>p[1]),out=[];
for(let n=0;out.length<4&&n<5000;n++){const p=[Math.min(...xs)+r()*(Math.max(...xs)-Math.min(...xs)),Math.min(...ys)+r()*(Math.max(...ys)-Math.min(...ys))];if(!inside(p,poly))continue;
const d=pk.demo[Math.floor(r()*pk.demo.length)],m=.4+r()*2.6,w=5+r()*35,a=80+r()*820,cf=["high","medium","medium","low"][Math.floor(r()*4)],q=ll(p);
out.push({kind:d[0],note:d[1].replace("{m}",m.toFixed(1)).replace("{w}",w.toFixed(0)).replace("{a}",a.toFixed(0)),cf,loc:q.map(v=>v.toFixed(5))})}
const o={high:0,medium:1,low:2};return out.sort((a,b)=>o[a.cf]-o[b.cf])}
const BAD=/\b(is|are|be|declared|deemed) safe\b|no risk|all clear|guarantee|nothing to worry/i;
function report(worry,pk,status,pl,fs){const L=["# Survey report","","> **SIMULATED RESULTS.** No aircraft flew and no real images were analysed. This shows the format of the finished report only.","","## Your concern","“"+worry+"”","","## What we checked",
`We matched your concern to **${pk.title}** (${status==="confident"?"matched automatically":"confirmed by you"}). We planned a survey of ${pl.ha} ha with ${pl.photos} photos at ${Math.round(pl.alt)} m (about ${pl.gsd} cm per pixel), using: ${pk.sensor}.`,"","Steps applied to the images:",...pk.analysis.map(a=>"- "+a),"","## What we found",
...fs.map((f,i)=>`${i+1}. **${f.kind}** (${f.cf} confidence) at ${f.loc[0]}, ${f.loc[1]}. ${f.note}.`),"","## How much to trust this",...pk.limits.map(x=>"- "+x),"","## Suggested next steps",...pk.next.map(x=>"- "+x),"","## Review required",
`This report is a screening aid, not a safety certificate. It should be reviewed by ${pk.expert} before anyone changes where people live, work or travel because of it.`,`Revisit schedule: ${pk.revisit}.`];
const t=L.join("\n"),m=t.match(BAD);if(m)throw new Error("Report contains over-reassuring wording: "+m[0]);return t}
function md(t){const esc=s=>s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");let out=[],list=null;const close=()=>{if(list){out.push("</"+list+">");list=null}};
for(const raw of t.split("\n")){const l=esc(raw).replace(/\*\*(.+?)\*\*/g,"<b>$1</b>");let m;
if(m=l.match(/^## (.*)/)){close();out.push("<h3>"+m[1]+"</h3>")}else if(m=l.match(/^# (.*)/)){close();out.push("<h2>"+m[1]+"</h2>")}
else if(m=l.match(/^&gt; (.*)/)){close();out.push('<p class="sim">'+m[1]+"</p>")}
else if(m=l.match(/^- (.*)/)){if(list!=="ul"){close();out.push("<ul>");list="ul"}out.push("<li>"+m[1]+"</li>")}
else if(m=l.match(/^\d+\. (.*)/)){if(list!=="ol"){close();out.push("<ol>");list="ol"}out.push("<li>"+m[1]+"</li>")}
else if(!l.trim()){close()}else{close();out.push("<p>"+l+"</p>")}}close();return out.join("")}
function run(pid){$("err").textContent="";$("ask").innerHTML="";$("ask").className="";
const worry=$("worry").value.trim();
if(pts.length<3)return $("err").textContent="Click at least three points on the map to mark the area.",0;
if(!worry)return $("err").textContent="Describe your concern in a few words.",0;
if(!isFinite(LAT())||!isFinite(LON())||Math.abs(LAT())>90||Math.abs(LON())>180)return $("err").textContent="Enter a valid centre latitude and longitude.",0;
if(area(pts)/1e4>2000)return $("err").textContent="That area is over 2000 ha. Draw a smaller area or split it into several surveys.",0;
let alt=$("alt").value===""?null:+$("alt").value;if(alt!==null&&!(alt>=30&&alt<=120))return $("err").textContent="Altitude must be between 30 and 120 m.",0;
let pk,status;const chosen=pid||$("pack").value;
if(chosen){pk=PACKS.find(p=>p.id===chosen);status="confirm"}
else{const[st,s]=matchWorry(worry);
if(st!=="confident"){const a=$("ask");a.className="ask";a.innerHTML=st==="none"?"<b>I could not tell what the concern is.</b> Pick the closest scenario:":"<b>I am not sure which scenario fits.</b> Pick one:";
(st==="none"?PACKS:s.filter(x=>x[0]>0).map(x=>x[1])).forEach(p=>{const b=document.createElement("button");b.textContent=p.title;b.onclick=()=>run(p.id);a.appendChild(b)});return}
pk=s[0][1];status=st}
let pl;try{pl=planMission(pk,pts,alt)}catch(e){return $("err").textContent=e.message,0}
let rep=null;if($("demo").checked){try{rep=report(worry,pk,status,pl,demoFindings(pk,pts))}catch(e){return $("err").textContent=e.message,0}}
last=rep;path=pl.wp;draw();
$("ot").textContent=pk.title;$("os").textContent=`Sensor: ${pk.sensor}. Best timing: ${pk.timing} Revisit: ${pk.revisit}.`;
$("nums").innerHTML=[["Area",pl.ha+" ha"],["Flight time",pl.min+" min"],["Battery sets",pl.batt],["Photos",pl.photos],["Distance",pl.km+" km"],["Altitude",Math.round(pl.alt)+" m"],["Detail",pl.gsd+" cm per pixel"],["Flight lines",pl.lines]].map(x=>`<div><dt>${x[0]}</dt><dd>${x[1]}</dd></div>`).join("");
$("rep").innerHTML=rep?md(rep):'<p class="note">A report is written after a real survey. Tick the sample report option to preview its format.</p>';
$("cp").hidden=!rep;$("cpm").textContent="";$("out").hidden=false;$("out").scrollIntoView({behavior:"smooth"})}
$("go").onclick=()=>run();
$("cp").onclick=async()=>{try{await navigator.clipboard.writeText(last);$("cpm").textContent="Copied."}catch(e){$("cpm").textContent="Could not copy automatically. Select the report text and copy it."}};
draw();
